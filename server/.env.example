# Required in production. 32+ random chars; encrypts WhatsApp tokens at rest.
SECRET_KEY=
# Operator key for /admin/* (setup service: create accounts, activate plans).
ADMIN_KEY=
# Meta app → WhatsApp → Configuration. Webhook URL: https://YOUR-HOST/webhook
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
GRAPH_VERSION=v26.0
# false = invite/onboarding-code only
ALLOW_SIGNUP=true
DATABASE_PATH=autometa.db
PORT=8080
# AI assistant (Business plan). Any OpenAI-compatible endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Google Play subscriptions (optional; manual activation works without it)
GOOGLE_PLAY_PACKAGE=dev.autometa.app
GOOGLE_SERVICE_ACCOUNT_JSON=
RTDN_TOKEN=
# Optional price override, e.g. {"pro":{"monthly":6000}}
PRICING_JSON=
