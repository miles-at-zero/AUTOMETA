# Required in production. 32+ random chars; encrypts WhatsApp tokens at rest.
SECRET_KEY=
# Operator key for /admin/* (setup service: create accounts, activate plans).
ADMIN_KEY=
# Meta app → WhatsApp → Configuration. Webhook URL: https://YOUR-HOST/webhook
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
GRAPH_VERSION=v26.0
# false = invite/onboarding-code only
ALLOW_SIGNUP=true
DATABASE_PATH=autometa.db
PORT=8080
# AI assistant (Business plan). Any OpenAI-compatible endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Google Play subscriptions (optional; manual activation works without it)
GOOGLE_PLAY_PACKAGE=dev.autometa.app
GOOGLE_SERVICE_ACCOUNT_JSON=
RTDN_TOKEN=
# Optional price override, e.g. {"pro":{"monthly":6000}}
PRICING_JSON=

# ---- Cloud platform ---------------------------------------------------------
# Public HTTPS base URL of this server (no trailing slash). Used for OAuth
# redirects (PUBLIC_URL/oauth/google/callback) and webhook URLs.
PUBLIC_URL=https://api.example.com
# Restrict browser CORS (the Android app is not affected). Default *.
CORS_ORIGIN=
WEBHOOK_RATE_PER_MIN=60
# Gmail (EXTERNAL CONFIG REQUIRED). Google Cloud Console → OAuth client
# (Web application), redirect URI = PUBLIC_URL/oauth/google/callback,
# Gmail API enabled. Without these Gmail is listed as unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Device push (EXTERNAL CONFIG REQUIRED). Firebase service-account JSON (one
# line) for FCM HTTP v1. Without it notifications stay in-app only.
FCM_SERVICE_ACCOUNT_JSON=
# Password reset email (optional)
RESEND_API_KEY=
MAIL_FROM=
